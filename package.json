{
  "name": "@yuneta/gobj-ui",
  "version": "7.27.11",
  "type": "module",
  "main": "dist/gobj-ui.cjs.js",
  "module": "dist/gobj-ui.es.js",
  "exports": {
    ".": {
      "import": "./dist/gobj-ui.es.js",
      "require": "./dist/gobj-ui.cjs.js"
    },
    "./index.js": "./index.js",
    "./vite-plugin-yuneta-html.js": "./vite-plugin-yuneta-html.js",
    "./src/*": "./src/*"
  },
  "files": [
    "dist/gobj-ui.es.js",
    "dist/gobj-ui.cjs.js",
    "index.js",
    "src/",
    "vite-plugin-yuneta-html.js",
    "scripts/check-markup-strings.mjs",
    "scripts/validate-locales.mjs"
  ],
  "description": "Yuneta UI Library — the active line: declarative shell (C_YUI_SHELL+NAV+PAGER+WIZARD) + windows, TreeDB views, forms, charts and maps.  Consumed from the npm registry by the Yuneta SPAs (gui_agent, gui_treedb, wattyzer, yunovatios, yunomusica, estadodelaire).  The frozen legacy GClass GUI stack (C_YUI_MAIN/TABS/ROUTING) lives on the v1 branch, npm dist-tag 'legacy' (consumed by hidraulia).",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "check-markup": "node scripts/check-markup-strings.mjs",
    "prebuild": "npm run check-markup",
    "pretest": "npm run check-markup",
    "qa-history": "node scripts/qa-history.mjs",
    "qa-cell-editor": "node scripts/qa-cell-editor.mjs",
    "deploy-round": "node scripts/deploy-round.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "acorn": "^8.19.0"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@yuneta/gobj-js": "^7.26.28",
    "vite": "^8.3.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@antv/g6": "^5.1.0",
    "@yuneta/gobj-js": "^7.26.3",
    "bulma": "^1.0.4",
    "i18next": "^26.4.5",
    "maplibre-gl": "^6.14.0",
    "tabulator-tables": "^6.5.3",
    "tom-select": "^2.6.2",
    "uplot": "^1.6.32",
    "vanilla-jsoneditor": "^3.13.0"
  }
}
